rules_version = '2';
// QSA Firestore 보안 규칙
//  1. 'allow read, write: if true' 금지
//  2. 계정(qsa_admins)에 등록된 Google 계정만 접근
//  3. 관리자(role: "admin") = 전체 메뉴 + 계정 관리 / 일반(member) = menus 에 있는 메뉴의 데이터만
//  4. 개인 데이터(qsa_users/{uid})는 본인만
//  5. 규칙에 적지 않은 경로는 전부 차단
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function accountPath() {
      return /databases/$(database)/documents/qsa_admins/$(myEmail());
    }
    // 등록된 계정
    function isMember() {
      return verified() && exists(accountPath());
    }
    function account() {
      return get(accountPath()).data;
    }
    // 관리자
    function isAdmin() {
      return isMember() && account().get('role', 'member') == 'admin';
    }
    // 메뉴 권한: 관리자이거나 menus 에 그 메뉴 ID 가 있을 때
    function canUse(menu) {
      return isMember()
        && (account().get('role', 'member') == 'admin'
            || menu in account().get('menus', []));
    }
    // 계정 문서 형식 검사 (계정 관리 화면에서 쓰는 값만 허용)
    function validAccount(d) {
      return d.keys().hasOnly(['name', 'dept', 'role', 'menus', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.dept is string && d.dept.size() > 0 && d.dept.size() <= 30
        && d.role in ['admin', 'member']
        && d.menus is list && d.menus.size() <= 50
        && d.updatedBy == myEmail()
        && d.updatedAt == request.time;
    }

    // 연결 주소 형식 검사 (Apps Script 웹 앱만)
    function validLink(l) {
      return l.url is string
        && l.url.matches('^https://script[.]google[.]com/macros/s/[A-Za-z0-9_-]+/exec$')
        && l.updatedBy is string;
    }

    // ── 계정 (문서 ID = 이메일 소문자) ──
    // · 본인 문서는 누구나 조회(허용 여부·권한 확인용), 목록은 관리자만
    // · 추가·수정·삭제는 관리자만, 본인 계정은 불가(콘솔에서만) → 실수로 관리자 권한을 잃는 것 방지
    match /qsa_admins/{email} {
      allow get: if verified() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email != myEmail()
        && email == email.lower()
        && validAccount(request.resource.data);
      allow delete: if isAdmin() && email != myEmail();
    }

    // ── 본인 데이터 ──
    match /qsa_users/{uid} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // ── QSA 공통 기록 ──
    match /qsa_meta/{docId} {
      allow read, write: if isAdmin()
        || (docId == 'enroll_import' && canUse('enroll'))
        || (docId == 'cert_import' && canUse('cert'))
        || (docId == 'seat_import' && canUse('seating'));
    }

    // ── 등록현황 (메뉴 ID: enroll) ──
    match /quettaReg_daily/{docId} {
      allow read, write: if canUse('enroll');
    }
    match /quettaReg_config/{docId} {
      allow read, write: if canUse('enroll');
    }
    match /quettaReg_rawlog/{docId} {
      allow read, write: if canUse('enroll');
    }

    // ── 연결 설정 (매년 바뀌는 Apps Script 주소 등) ──
    // 쓰기는 관리자만, 읽기는 관리자 또는 그 주소를 쓰는 메뉴 권한
    match /qsa_settings/links {
      allow read: if isAdmin() || canUse('cert') || canUse('sms');
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['certRoster', 'smsArchive'])
        && (!('certRoster' in request.resource.data) || validLink(request.resource.data.certRoster))
        && (!('smsArchive' in request.resource.data) || validLink(request.resource.data.smsArchive));
    }
    // 증명서 직인: 공개 주소에 두지 않고 여기에 보관. 관리자만 올리기, 증명서 권한만 읽기
    match /qsa_settings/seal {
      allow read: if isAdmin() || canUse('cert');
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['dataUrl', 'updatedAt', 'updatedBy'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.split(',')[0] in ['data:image/png;base64', 'data:image/jpeg;base64', 'data:image/webp;base64']
        && request.resource.data.dataUrl.size() < 900000
        && request.resource.data.updatedBy == myEmail();
    }

    // ── 증명서 발급 (메뉴 ID: cert) ──
    // 학생 명단: DSA 원생 마스터에서 필요한 열만 저장한 문서 1개
    match /cert_roster/{docId} {
      allow read: if canUse('cert');
      allow write: if canUse('cert')
        && docId == 'current'
        && request.resource.data.keys().hasOnly(['students', 'updatedAt', 'updatedBy', 'fileName'])
        && request.resource.data.students is list
        && request.resource.data.updatedBy == myEmail();
    }
    match /certificates/{docId} {
      allow read, write: if canUse('cert');
    }
    match /certConfig/{docId} {
      allow read, write: if canUse('cert');
    }

    // ── 좌석 배정 (메뉴 ID: seating) ──
    match /seat_state/{docId} {
      allow read, write: if canUse('seating');
    }
    match /seat_snapshots/{docId} {
      allow read, write: if canUse('seating');
    }
    match /seat_logs/{docId} {
      allow read, create: if canUse('seating');
      allow update, delete: if isAdmin();
    }

    // ── 다음 메뉴를 이식하면 같은 방식으로 추가합니다 ──
    // match /컬렉션/{docId} { allow read, write: if canUse('메뉴ID'); }

    // 그 외 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
