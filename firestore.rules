rules_version = '2';
// QSA (quetta-qsa) Firestore 보안 규칙
// 원칙
//  1. 'allow read, write: if true' 절대 금지
//  2. 교무 허용목록(qsa_admins)에 있는 Google 계정만 접근
//  3. 개인 데이터(qsa_users/{uid})는 본인만 접근
//  4. 규칙에 적지 않은 경로는 전부 차단 → 새 모듈은 컬렉션을 아래에 하나씩 명시해서 엽니다
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isQsaAdmin() {
      return verified()
        && exists(/databases/$(database)/documents/qsa_admins/$(myEmail()));
    }

    // 허용목록: 문서 ID = 이메일(소문자)
    // · 로그인한 사람은 "자기 이메일 문서"만 조회 가능 → 화면에서 허용 여부 안내용
    // · 목록 조회는 허용된 교무만
    // · 쓰기는 앱에서 불가, Firebase 콘솔에서만 관리
    match /qsa_admins/{email} {
      allow get: if verified() && email == myEmail();
      allow list: if isQsaAdmin();
      allow write: if false;
    }

    // 본인 데이터만 접근 (설정, 마지막 접속 등)
    match /qsa_users/{uid} {
      allow read, write: if isQsaAdmin() && request.auth.uid == uid;
    }

    // ── 1단계에서 모듈별 컬렉션을 여기에 추가합니다 ──
    // 예)
    // match /scholarship/{docId} {
    //   allow read, write: if isQsaAdmin();
    // }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
